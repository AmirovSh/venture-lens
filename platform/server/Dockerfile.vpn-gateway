FROM public.ecr.aws/docker/library/python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends openvpn curl iproute2 dnsutils ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY corporate_gateway.py /app/corporate_gateway.py
USER 10001
CMD ["python", "/app/corporate_gateway.py"]
