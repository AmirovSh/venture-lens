# Copy to .env.local. Do not put credentials into Git.
# Configure model server settings locally.
# Or supply LLM_BASE_URL, LLM_API_KEY, LLM_MODEL directly.
# LLM_BASE_URL=https://your-openai-compatible-gateway/v1
# LLM_API_KEY=
# LLM_MODEL=
LLM_TRUST_ENV=false
# Windows corporate mTLS (do not export the private key):
# LLM_BASE_URL=https://your-corporate-gateway/v1
# LLM_TRANSPORT=schannel
# LLM_CLIENT_CERT=CurrentUser\MY\certificate-thumbprint
# LLM_REVOCATION_BEST_EFFORT=true
DATABASE_URL=sqlite:///./data/venture-lens.db
# Optional Exa search; without a key use DuckDuckGo public HTML search.
# EXA_API_KEY=
# Or use an existing trusted local SearXNG instance:
# SEARXNG_URL=http://127.0.0.1:8088
# SEARCH_TRUST_ENV=true
