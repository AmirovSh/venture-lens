# Set deployment values through the environment. Keep credentials outside Git.
# Configure an OpenAI-compatible model server.
# LLM_BASE_URL=https://models.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4-flash
LLM_TRUST_ENV=false
# DATABASE_URL=postgresql+psycopg://user:password@db.example.com/venturelens
# Optional independent search fallback. Public search is opt-in when configured providers fail.
# EXA_API_KEY=
# Or use an approved SearXNG service:
# SEARXNG_URL=https://search.example.com
# SEARCH_TRUST_ENV=true

# Independent LLM gateway (a different model on the same URL is not a separate failure domain):
# LLM_FALLBACK_BASE_URL=https://independent-gateway/v1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=
# Shared S3 (required for worker replicas on different hosts):
# S3_ENDPOINT_URL=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=venture-lens
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# LLM_MAX_CONCURRENCY=2
# LLM_REQUESTS_PER_MINUTE=30
# ALLOW_PUBLIC_SEARCH=false
# Linux mTLS: mount secret files; never put private keys in the image.
# LLM_CA_FILE=/run/certs/ca.pem
# LLM_CLIENT_CERT_FILE=/run/certs/client.pem
# LLM_CLIENT_KEY_FILE=/run/certs/client.key
